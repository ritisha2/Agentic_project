# =============================================================================
# ESP APM — Environment Configuration
# =============================================================================

# LLM Gateway Architecture — Office Server (Ubuntu Xeon, CPU inference)
# All Agent Jane reasoning/inference runs on the office server exclusively —
# not localhost. Server: 192.168.1.191, llama-server on :8080, Qwen2.5-Coder-3B-Instruct
# (Q4_K_M GGUF), tuned with numactl + --mlock + --flash-attn. See ops notes for the
# full launch command if the server ever needs to be restarted.
LLM_GATEWAY_URL=http://192.168.1.191:8080/v1
LLM_MODEL_NAME=Qwen2.5-Coder-3B-Instruct-Q4_K_M
# Measured server throughput ~7.4 tok/s; full agent completions have taken 48-66s in
# past sessions, so 60s (the .env.example default) is too tight a margin over the
# network on a shared office server. Using the code's own built-in default (120s).
LLM_TIMEOUT_SEC=120
LLM_MAX_RETRIES=3
LLM_HEALTH_TIMEOUT_SEC=2.0
# LLM_OFFLINE is intentionally NOT settable — offline/mock mode is disabled at the code
# level (src/llm/gateway.py) by project policy. The real LLM server is always used.

# Database & Graph Configuration
QDRANT_URL=http://localhost:6333
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
POSTGRES_URL=postgresql://localhost:5432/esp_agent
