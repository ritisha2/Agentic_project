# =============================================================================
# ESP APM — Environment Configuration
# =============================================================================

# LLM Gateway Architecture — Local NVIDIA RTX 3050 GPU (CUDA Acceleration)
# Inference runs locally on GPU via llama-server with -ngl 99 at ~58 tok/s (1.8s latency).
LLM_GATEWAY_URL=http://127.0.0.1:8080/v1
LLM_MODEL_NAME=Qwen2.5-Coder-3B-Instruct-Q4_K_M
LLM_TIMEOUT_SEC=30
LLM_MAX_RETRIES=3
LLM_HEALTH_TIMEOUT_SEC=2.0
# LLM_OFFLINE is intentionally NOT settable — offline/mock mode is disabled at the code
# level (src/llm/gateway.py) by project policy. The real LLM server is always used.

# Database & Graph Configuration
QDRANT_URL=http://localhost:6333
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
POSTGRES_URL=postgresql://localhost:5432/esp_agent
