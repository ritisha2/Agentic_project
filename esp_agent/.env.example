# =============================================================================
# ESP APM — Environment Configuration
# =============================================================================

# LLM Gateway Architecture (llama.cpp CPU Local Server)
# Client Requirement: NO GPU DEPENDENCY -> Run llama-server on CPU
LLM_GATEWAY_URL=http://localhost:8080/v1
LLM_MODEL_NAME=qwen2.5-3b-instruct
LLM_TIMEOUT_SEC=60
LLM_MAX_RETRIES=3
LLM_HEALTH_TIMEOUT_SEC=2.0
# LLM_OFFLINE is intentionally NOT settable — offline/mock mode is disabled at the code
# level (src/llm/gateway.py) by project policy. The real LLM server is always used.

# Database & Graph Configuration
QDRANT_URL=http://localhost:6333
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
POSTGRES_URL=postgresql://localhost:5432/esp_agent
