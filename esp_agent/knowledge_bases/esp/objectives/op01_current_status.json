  "required_evidence": ["current_snapshot"],
  "required_tools": ["get_asset_context", "get_live_snapshot"],
  "allowed_specialists": ["well_performance"],
  "safety": {
    "advisory_only": true,
    "forbidden_actions": ["autonomous_control"]
