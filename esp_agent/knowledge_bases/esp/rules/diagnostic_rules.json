{
  "rules": [
    {
      "rule_id": "RULE_TEMP_WARN",
      "metric_name": "primary_thermal_metric",
      "operator": ">",
      "threshold": 130.0,
      "severity": "warning",
      "description": "Motor temperature exceeds warning threshold of 130°C."
    },
    {
      "rule_id": "RULE_TEMP_CRIT",
      "metric_name": "primary_thermal_metric",
      "operator": ">",
      "threshold": 150.0,
      "severity": "critical",
      "description": "Motor temperature exceeds critical threshold of 150°C."
    },
    {
      "rule_id": "RULE_PIP_WARN",
      "metric_name": "primary_intake_pressure",
      "operator": "<",
      "threshold": 150.0,
      "severity": "warning",
      "description": "Intake pressure drops below warning threshold of 150 psi (Gas lock risk)."
    },
    {
      "rule_id": "RULE_PIP_CRIT",
      "metric_name": "primary_intake_pressure",
      "operator": "<",
      "threshold": 100.0,
      "severity": "critical",
      "description": "Intake pressure drops below critical threshold of 100 psi."
    },
    {
      "rule_id": "RULE_VIB_WARN",
      "metric_name": "vibration_metric",
      "operator": ">",
      "threshold": 3.0,
      "severity": "warning",
      "description": "Radial vibration exceeds warning threshold of 3.0 g."
    },
    {
      "rule_id": "RULE_VIB_CRIT",
      "metric_name": "vibration_metric",
      "operator": ">",
      "threshold": 5.0,
      "severity": "critical",
      "description": "Radial vibration exceeds critical threshold of 5.0 g."
    },
    {
      "rule_id": "RULE_AXIAL_VIB_WARN",
      "metric_name": "axial_vibration_metric",
      "operator": ">",
      "threshold": 1.5,
      "severity": "warning",
      "description": "Axial vibration exceeds warning threshold of 1.5 g."
    },
    {
      "rule_id": "RULE_IMBALANCE_WARN",
      "metric_name": "current_phase_imbalance",
      "operator": ">",
      "threshold": 5.0,
      "severity": "warning",
      "description": "Current phase imbalance exceeds warning threshold of 5%."
    },
    {
      "rule_id": "RULE_IMBALANCE_CRIT",
      "metric_name": "current_phase_imbalance",
      "operator": ">",
      "threshold": 10.0,
      "severity": "critical",
      "description": "Current phase imbalance exceeds critical threshold of 10%."
    },
    {
      "rule_id": "RULE_BACKSPIN_LOCKOUT",
      "metric_name": "time_since_trip_seconds",
      "operator": "<",
      "threshold": 1800.0,
      "severity": "critical",
      "description": "Post-trip restart lockout active; fluid column backspin equalizing window (< 1800s)."
    },
    {
      "rule_id": "RULE_CHOKE_START_FLOATERS",
      "metric_name": "wellhead_choke_position",
      "operator": "==",
      "threshold": 100.0,
      "severity": "warning",
      "description": "Floating pump startup with wide open choke detected; must pinch to 30% to seat impellers."
    },
    {
      "rule_id": "RULE_UNDERLOAD_DEADHEAD",
      "metric_name": "primary_electrical_load",
      "operator": "<",
      "threshold": 80.0,
      "severity": "critical",
      "description": "Underload protection triggered below 80% normal current; zero fluid flow deadheading risk."
    },
    {
      "rule_id": "RULE_UPTHRUST_OVERLOAD",
      "metric_name": "primary_electrical_load",
      "operator": ">",
      "threshold": 110.0,
      "severity": "warning",
      "description": "Undersized pump running in upthrust with motor overloaded exceeding 110% nameplate current."
    },
    {
      "rule_id": "RULE_WATER_CUT_DERATE",
      "metric_name": "motor_power_loading",
      "operator": ">",
      "threshold": 100.0,
      "severity": "warning",
      "description": "High water cut density overload detected; VSD frequency reduction required to derate power."
    }
  ]
}
